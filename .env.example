# 로컬 개발용 Odoo DB 비밀번호 (실제 값은 .env 에)
ODOO_DB_PASSWORD=odoo

# Odoo 화면에서 만든 DB 이름
ODOO_DB_NAME=erp
# 질의 계층용 읽기 전용 역할 (scripts/db-readonly-role.sh)
NLQ_RO_USER=nlq_readonly
NLQ_RO_PASSWORD=change-me
# RLS 비교 경로 (M6, ADR 0005). 비우면 NLQ_RO_PASSWORD를 쓴다
NLQ_RLS_USER=nlq_rls
NLQ_RLS_PASSWORD=
# 행 범위를 거는 방식: guard(기본) | rls | both
NLQ_ENFORCE=guard

# 생성·평가용 Claude API (평가 전용 키, 콘솔에서 월 한도 설정)
ANTHROPIC_API_KEY=
# 개발·CI는 claude-haiku-5-5, 결과 표용 측정은 claude-opus-5-5
EVAL_MODEL=claude-haiku-5-5
